# Resend API Key (get your free key from https://resend.com/api-keys)
RESEND_API_KEY=re_your_api_key_here

# Destination inbox for portfolio messages (defaults to ryleanthony.gabotero@gmail.com)
CONTACT_EMAIL=ryleanthony.gabotero@gmail.com

# Sender email - using verified custom domain on Resend
RESEND_FROM_EMAIL=contact@ryleanthony-gabotero.tech

# Production site URL (used for canonical tags, sitemap.xml, and OpenGraph cards)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Server-only token used to read the lifetime pageview total from Vercel Web Analytics
# Create one at https://vercel.com/account/settings/tokens (never prefix this with NEXT_PUBLIC_)
VERCEL_API_TOKEN=your_vercel_access_token

# Available automatically on Vercel when system environment variables are enabled
VERCEL_PROJECT_ID=prj_your_project_id

# Required only for a team-owned project; personal projects should leave this blank
VERCEL_TEAM_ID=

# Serverless Redis used only for anonymous, 60-second online presence
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token
