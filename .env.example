# Resend API Key (get your free key from https://resend.com/api-keys)
RESEND_API_KEY=re_your_api_key_here

# Destination inbox for portfolio messages (defaults to ryleanthony.gabotero@gmail.com)
CONTACT_EMAIL=ryleanthony.gabotero@gmail.com

# Sender email - onboarding@resend.dev works out-of-the-box on Resend free tier,
# or use your verified domain (e.g. Portfolio <contact@rylegabotero.dev>)
RESEND_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>

# Production site URL (used for canonical tags, sitemap.xml, and OpenGraph cards)
NEXT_PUBLIC_SITE_URL=https://your-domain.com
